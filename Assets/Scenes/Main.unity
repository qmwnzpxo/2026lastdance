  - chapterID: Chapter 1
    title: "Chapter1. \uC57C\uBC24\uC758 \uB124\uC628\uC0AC\uC778"
    background: {fileID: 21300000, guid: 770ed767c05e44646b2a2fadda4eb0ea, type: 3}
    description: "\uD604\uC7AC \uD504\uB780\uD1A4 \uC2DC\uD2F0\uC5D0\uC11C \uC9C0\uB0B4\uB294
      \uC8FC\uC778\uACF5\uC740 \uACFC\uAC70 \uBC31\uD654\uC810 \uD14C\uB7EC \uC0AC\uAC74\uC73C\uB85C
      \uC778\uD574 \uAC00\uC871\uC744 \uC783\uACE0 \uB9D0\uC558\uB2E4. \uC8FC\uC778\uACF5\uC740
      2\uB144\uAC04 \uB2E8\uC11C\uB97C \uCC3E\uC544\uB2E4\uB154\uACE0, \uCC3E\uC544\uB0B8
      \uC815\uBCF4\uB97C \uCDE8\uD569\uD558\uC5EC \uD14C\uB7EC \uC0AC\uAC74\uC5D0
      \uC5F0\uB8E8\uB418\uC5B4 \uC788\uB294 \uC870\uC9C1\uC774 \uD504\uB780\uD1A4
      \uC2DC\uD2F0\uC5D0 \uAC70\uCC98\uB97C \uB450\uACE0 \uC788\uB2E4\uB294 \uAC83\uC744
      \uAE68\uB2EB\uACE0, \uB3D9\uC0DD\uC774 \uC790\uC2E0\uC744 \uC704\uD574 \uC900\uBE44\uD574\uC900
      \uC7A5\uBE44\uB97C \uCC59\uACA8 \uD504\uB780\uD1A4 \uC2DC\uD2F0\uC5D0\uC11C
      \uACBD\uCC30\uAD00\uC73C\uB85C \uD65C\uB3D9\uD558\uBA70 \uB0AE\uC5D0\uB294
      \uC870\uC0AC\uB97C, \uBC24\uC5D0\uB294 \uC6A9\uBCD1\uC73C\uB85C\uC368 \uD604\uC7A5\uC744
      \uC2B5\uACA9\uD558\uBA70 \uC0DD\uD65C\uC744 \uC774\uC5B4\uAC04\uB2E4."
    defaultState: 0
    titleKey: Chapter1Title
    descriptionKey: Chapter1Description
    onContinue:
      m_PersistentCalls:
        m_Calls: []
    onPlay:
      m_PersistentCalls:
        m_Calls: []
    onReplay:
      m_PersistentCalls:
        m_Calls: []
  - chapterID: Chapter 2
    title: "Chapter2. \uBA38\uB9AC\uC640 \uAE30\uACC4"
    background: {fileID: 21300000, guid: 231822b12b14f3443b5e434816cf9143, type: 3}
    description: "\uC870\uC0AC\uB97C \uC774\uC5B4\uAC00\uB358 \uC8FC\uC778\uACF5\uC740
      \uC0C8\uB85C\uC6B4 \uB3D9\uB8CC\uC778 \uACBD\uCC30\uAD00\uB4E4, \uC790\uC2E0\uC758
      \uC5C5\uBB34\uB97C \uB3C4\uC640\uC8FC\uB294 \uC120\uBC30, \uADF8\uB9AC\uACE0
      \uB3D9\uB124 \uC18C\uB140\uC640 \uC0DD\uD65C\uC744 \uC774\uC5B4\uAC04\uB2E4.
      \uADF8\uB7F0\uB370 \uC870\uC0AC\uB97C \uC774\uC5B4\uAC00\uB358 \uC5B4\uB290\uB0A0
      \uBC24, \uBA38\uB9AC\uC5D0 \uC774\uC0C1\uD55C \uC2DC\uC220\uC744 \uD558\uB294
      \uC870\uC9C1\uC744 \uBC1C\uACAC\uD55C\uB2E4. \uC774 \uC870\uC9C1\uC758 \uC774\uB984\uC740
      \uAC00\uB2C8\uCFE0\uB2E4\uD30C. \uD504\uB780\uD1A4 \uC2DC\uD2F0\uC758 \uC720\uD765\uAC00\uB97C
      \uC9C0\uBC30\uD558\uB294 \uC870\uC9C1\uC774\uC5C8\uB2E4. \uC8FC\uC778\uACF5\uC740
      \uC6A9\uBCD1\uC73C\uB85C\uC368 \uC870\uC0AC\uB97C \uC2DC\uC791\uD558\uACE0,
      \uC774\uB0B4 \uACBD\uCC30\uC774 \uB3C4\uC2DC \uB0B4 \uB09C\uD22C\uC0AC\uAC74\uC73C\uB85C
      \uC9C4\uC785\uD558\uAE30 \uC804 \uAC00\uB2C8\uCFE0\uB2E4\uD30C\uC758 \uBCF8\uBD80
      \uC800\uD0DD\uAE4C\uC9C0 \uCCD0\uB4E4\uC5B4\uAC00 \uC218\uB1CC\uBD80\uC5D0\uAC8C
      \uC815\uBCF4\uB97C \uC5BB\uC5B4\uB0B4\uACE0 \uD0C8\uCD9C\uD55C\uB2E4. \uD558\uC9C0\uB9CC
      \uB3D9\uC77C\uD55C \uC2DC\uAC01, \uC8FC\uC778\uACF5\uC758 \uB3D9\uB8CC\uB4E4\uC740
      \uD604\uC7A5\uC5D0 \uB0A8\uC544\uC788\uB294 \uD754\uC801\uC744 \uBC1C\uACAC\uD558\uAC8C
      \uB41C\uB2E4.\r\n"
    defaultState: 0
    titleKey: Chapter2Title
    descriptionKey: Chapter2Description
    onContinue:
      m_PersistentCalls:
        m_Calls: []
    onPlay:
      m_PersistentCalls:
        m_Calls: []
    onReplay:
      m_PersistentCalls:
        m_Calls: []
  - chapterID: Chapter 3
    title: "Chapter3. \uCE68\uBB35\uC758 \uB3C4\uC2DC"
    background: {fileID: 21300000, guid: 93c7a66a2c6e2864c800bef5427bd672, type: 3}
    description: "\uAC00\uB2C8\uCFE0\uB2E4\uD30C \uC218\uB1CC\uBD80\uC5D0\uAC8C \uC815\uBCF4\uB97C
      \uC5BB\uC740 \uC8FC\uC778\uACF5\uC740 \uB3C4\uC2DC\uC5D0 \uC554\uC57D\uD558\uB294
      \uC815\uBCF4\uC870\uC9C1\uC778 \u2018\uC544\uB77C\uB17C\u2019\uC5D0\uAC8C \uC811\uCD09\uD55C\uB2E4.
      \uC218\uB1CC\uBD80\uC5D0\uAC8C \uC5BB\uC740 \uC815\uBCF4\uB97C \uD1A0\uB300\uB85C
      \uACFC\uAC70\uC758 \uC0AC\uAC74\uC5D0 \uC5F0\uB8E8\uB418\uC5B4 \uC788\uB294
      \uC815\uBCF4\uB97C \uAC70\uB798\uD55C \uC8FC\uC778\uACF5\uC740 \uC544\uB77C\uB17C\uC758
      \uAC00\uAC8C\uC5D0\uC11C \uBC97\uC5B4\uB098\uC9C0\uB9CC, \uC544\uB77C\uB17C\uC5D0\uAC8C
      \uC790\uC2E0\uC774 \uB204\uAD6C\uC778\uC9C0 \uC798 \uAC10\uCD94\uB77C\uACE0
      \uACBD\uACE0\uB97C \uBC1B\uB294\uB2E4. \uC774\uD6C4 \uC0C8\uB85C\uC774 \uC5BB\uC740
      \uC815\uBCF4\uB97C \uD1A0\uB300\uB85C \uB3C4\uC2DC\uC758 \uBBFC\uAC04\uAD70\uC0AC\uAE30\uC5C5\uC778
      \uC5D0\uAE30PMC\uB97C \uC870\uC0AC\uD558\uB358 \uC8FC\uC778\uACF5\uC740\r\n\uB3C4\uC2DC\uC758
      \uC8FC\uC694 \uAE30\uC5C5\uC778 \uD504\uB780\uD1A4 \uACF5\uC5C5\uC758 \uC9C0\uC2DC\uB85C
      \uC5D0\uAE30PMC\uC5D0\uC11C \uC0AC\uB78C\uC744 \uB0A9\uCE58\uD558\uACE0 \uC788\uB2E4\uB294
      \uC218\uC0C1\uD55C \uC815\uBCF4\uB97C \uC785\uC218\uD55C\uB2E4. \uC774\uC5D0
      \uC6A9\uBCD1\uC73C\uB85C\uC368 \uB2E4\uC2DC \uC870\uC0AC\uB97C \uC7AC\uAC1C\uD55C
      \uC8FC\uC778\uACF5\uC740 \uC5D0\uAE30PMC\uC758 \uC218\uB1CC\uBD80\uC640 \uD1B5\uC2E0\uC73C\uB85C
      \uC811\uCD09\uD558\uB098, \uACFC\uAC70\uC758 \uC790\uC2E0\uC744 \uC54C\uC544\uBCF4\uB294
      \uC218\uB1CC\uBD80\uC5D0\uAC8C \uB2F9\uD669\uD574 \uAE30\uC2B5\uC744 \uBC1B\uACE0
      \uD6C4\uD1F4\uD558\uAC8C \uB41C\uB2E4. \uC0DD\uAC01\uC774 \uB9CE\uC544\uC9C4
      \uC8FC\uC778\uACF5\uC740 \uD68C\uBCF5 \uD6C4 \uB0AE\uC758 \uACBD\uCC30\uC11C\uC5D0\uC11C
      \uC77C\uC5D0 \uC9D1\uC911\uC744 \uBABB\uD558\uAC8C \uB418\uC5C8\uB294\uB370,
      \uC774\uB54C \uC120\uBC30\uAC00 \uC790\uC2E0\uC744 \uC800\uB141\uC2DD\uC0AC\uC5D0
      \uCD08\uB300\uD574 \uC120\uBC30\uC758 \uB3D9\uC0DD\uC778 \uC18C\uB140\uC640
      \uD568\uAED8 \uC2DD\uC0AC\uB97C \uD558\uAC8C \uB41C\uB2E4\r\n"
    defaultState: 0
    titleKey: Chapter3Title
    descriptionKey: Chapter3Description
    onContinue:
      m_PersistentCalls:
        m_Calls: []
    onPlay:
      m_PersistentCalls:
        m_Calls: []
    onReplay:
      m_PersistentCalls:
        m_Calls: []
